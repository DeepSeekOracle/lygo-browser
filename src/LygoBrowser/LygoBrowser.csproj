<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <AssemblyName>LygoBrowser</AssemblyName>
    <RootNamespace>LygoBrowser</RootNamespace>
    <Version>1.9.1</Version>
    <Product>LYGO BROWSER</Product>
    <Company>LYGO / Excavationpro</Company>
    <Description>LYGO Browser - agent and human browser with the Bookmark Bible</Description>
    <ApplicationIcon>brand\lygo-browser.ico</ApplicationIcon>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <StartupObject>LygoBrowser.App</StartupObject>
  </PropertyGroup>

  <!-- Public builds: map the builder's home tree out of the assembly. Without this the
       CodeView/PDB record bakes `<INSTALL_DIR>\src\...` into LygoBrowser.dll,
       which a public release must never contain. `-p:DebugType=none` does NOT remove it;
       only PathMap does. Build public artifacts with: -p:PublicBuild=true -->
  <PropertyGroup Condition="'$(PublicBuild)' == 'true'">
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    <PathMap>$(MSBuildProjectDirectory)=/_/src</PathMap>
    <DebugType>portable</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="<LAN_IP>" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="web\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="brand\**\*">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>

</Project>
