<Window x:Class="LygoBrowser.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:LygoBrowser"
        Title="LYGO BROWSER" Width="1440" Height="900" MinWidth="900" MinHeight="560"
        WindowStartupLocation="CenterScreen" WindowStyle="None" Background="{StaticResource Obsidian}"
        UseLayoutRounding="True" TextOptions.TextFormattingMode="Display"
        TextOptions.TextRenderingMode="ClearType" SnapsToDevicePixels="True">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Border BorderBrush="{StaticResource Line}" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="36"/>
                <RowDefinition Height="38"/>
                <RowDefinition Height="44"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="30"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="24"/>
            </Grid.RowDefinitions>

            <!-- ============ title bar ============ -->
            <Grid Grid.Row="0" Background="#070B10" MouseLeftButtonDown="TitleBar_MouseDown">
                <StackPanel Orientation="Horizontal" Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock Text="&#x25C6;" Foreground="{StaticResource Gold}" FontSize="12"
                               VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBlock Text="L Y G O" Foreground="{StaticResource Text}" FontSize="12.5"
                               FontWeight="SemiBold" VerticalAlignment="Center"/>
                    <TextBlock Text="B R O W S E R" Foreground="{StaticResource Gold}" FontSize="12.5"
                               FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/>
                    <Border Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}"
                            BorderThickness="1" CornerRadius="2" Padding="6,1" Margin="14,0,0,0"
                            VerticalAlignment="Center">
                        <TextBlock Text="BOOKMARK BIBLE" Foreground="{StaticResource Muted}"
                                   FontSize="8.5" FontFamily="{StaticResource MonoFont}"/>
                    </Border>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Border Style="{StaticResource Pill}" VerticalAlignment="Center" Cursor="Hand" ToolTip="Start the LYGO console (Manager + engine)" MouseLeftButtonUp="ConsolePill_Click" MouseEnter="Pill_Enter" MouseLeave="Pill_Leave">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ConsoleDot" Width="6" Height="6" Fill="{StaticResource Muted}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="ConsolePillText" Style="{StaticResource PillText}" Text="CONSOLE"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Pill}" VerticalAlignment="Center" Cursor="Hand" ToolTip="Start the LYGO Forge" MouseLeftButtonUp="ForgePill_Click" MouseEnter="Pill_Enter" MouseLeave="Pill_Leave">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="ForgeDot" Width="6" Height="6" Fill="{StaticResource Muted}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="ForgePillText" Style="{StaticResource PillText}" Text="FORGE"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Pill}" VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse x:Name="BridgeDot" Width="6" Height="6" Fill="{StaticResource Muted}"
                                     VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock x:Name="BridgePillText" Style="{StaticResource PillText}" Text="BRIDGE"/>
                        </StackPanel>
                    </Border>
                    <Border Style="{StaticResource Pill}" VerticalAlignment="Center">
                        <TextBlock x:Name="CdpPillText" Style="{StaticResource PillText}" Text="CDP"/>
                    </Border>
                    <Border Style="{StaticResource Pill}" VerticalAlignment="Center">
                        <TextBlock x:Name="CountPillText" Style="{StaticResource PillText}" Text="BIBLE 0"/>
                    </Border>
                    <Rectangle Width="1" Height="18" Fill="{StaticResource Line}" Margin="6,0,4,0"/>
                    <Button x:Name="MinBtn" Style="{StaticResource WinButton}" Content="&#xE921;"
                            Click="MinBtn_Click" ToolTip="Minimize"/>
                    <Button x:Name="MaxBtn" Style="{StaticResource WinButton}" Content="&#xE922;"
                            Click="MaxBtn_Click" ToolTip="Maximize"/>
                    <Button x:Name="CloseBtn" Style="{StaticResource WinButton}" Content="&#xE8BB;"
                            Click="CloseBtn_Click" ToolTip="Close"/>
                </StackPanel>
            </Grid>

            <!-- ============ tab strip ============ -->
            <Grid Grid.Row="1" Background="{StaticResource Panel}">
                <ScrollViewer x:Name="TabScroller" HorizontalScrollBarVisibility="Hidden"
                              VerticalScrollBarVisibility="Disabled" Margin="0,0,38,0">
                    <StackPanel x:Name="TabStrip" Orientation="Horizontal" Margin="6,0,0,0"/>
                </ScrollViewer>
                <Button x:Name="NewTabBtn" Style="{StaticResource GlyphButton}" Content="&#xE710;"
                        HorizontalAlignment="Right" Margin="0,0,4,0" Click="NewTabBtn_Click"
                        ToolTip="New tab (Ctrl+T)"/>
            </Grid>

            <!-- ============ toolbar ============ -->
            <Grid Grid.Row="2" Background="{StaticResource Panel}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="BackBtn" Style="{StaticResource GlyphButton}" Content="&#xE72B;"
                        Click="BackBtn_Click" ToolTip="Back (Alt+Left)"/>
                <Button Grid.Column="1" x:Name="FwdBtn" Style="{StaticResource GlyphButton}" Content="&#xE72A;"
                        Click="FwdBtn_Click" ToolTip="Forward (Alt+Right)"/>
                <Button Grid.Column="2" x:Name="ReloadBtn" Style="{StaticResource GlyphButton}" Content="&#xE72C;"
                        Click="ReloadBtn_Click" ToolTip="Reload (F5)"/>
                <Button Grid.Column="3" x:Name="HomeBtn" Style="{StaticResource GlyphButton}" Content="&#xE80F;"
                        Click="HomeBtn_Click" ToolTip="Home / Bible dashboard"/>

                <Grid Grid.Column="4" Margin="4,0,6,0" x:Name="AddressArea">
                    <TextBox x:Name="AddressBox" Style="{StaticResource AddressBox}" Padding="30,6,64,6"
                             KeyDown="AddressBox_KeyDown" GotKeyboardFocus="AddressBox_GotFocus"
                             LostKeyboardFocus="AddressBox_LostFocus" TextChanged="AddressBox_TextChanged"/>
                    <TextBlock x:Name="LockGlyph" IsHitTestVisible="False" Text="&#xE72E;"
                               FontFamily="{StaticResource GlyphFont}" FontSize="11"
                               Foreground="{StaticResource Mint}" VerticalAlignment="Center"
                               Margin="10,0,0,0" ToolTip="Connection"/>
                    <TextBlock x:Name="AddressHint" IsHitTestVisible="False" Foreground="#5A646C"
                               FontSize="12.5" Margin="32,0,60,0" VerticalAlignment="Center"
                               Text="Search the Bible, or enter a URL"/>
                    <Button x:Name="GoBtn" Style="{StaticResource TextButton}" Content="ENTER"
                            Foreground="{StaticResource Gold}" HorizontalAlignment="Right"
                            Margin="0,0,4,0" Click="GoBtn_Click"/>

                    <Popup x:Name="SuggestPopup" PlacementTarget="{Binding ElementName=AddressArea}"
                           Placement="Bottom" StaysOpen="False" AllowsTransparency="True"
                           PopupAnimation="Fade" Width="700">
                        <Border Background="#0C141A" BorderBrush="{StaticResource Line}"
                                BorderThickness="1" CornerRadius="4" Margin="0,2,0,0">
                            <ListBox x:Name="SuggestList" Background="Transparent" BorderThickness="0"
                                     MaxHeight="320" Foreground="{StaticResource Text}"
                                     MouseLeftButtonUp="SuggestList_Click"
                                     KeyDown="SuggestList_KeyDown">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="10,6"/>
                                        <Setter Property="Foreground" Value="{StaticResource Text}"/>
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="B" Background="Transparent" Padding="{TemplateBinding Padding}">
                                                        <ContentPresenter/>
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="B" Property="Background" Value="#16212A"/>
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="B" Property="Background" Value="#1B2A33"/>
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                            </ListBox>
                        </Border>
                    </Popup>
                </Grid>

                <Button Grid.Column="5" x:Name="StarBtn" Style="{StaticResource TextButton}"
                        Click="StarBtn_Click" ToolTip="Bookmark this page (Ctrl+D)">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE734;" FontFamily="{StaticResource GlyphFont}" FontSize="12"
                                   VerticalAlignment="Center" Margin="0,0,5,0"/>
                        <TextBlock Text="BOOKMARK" FontSize="10.5" FontWeight="SemiBold" VerticalAlignment="Center"/>
                    </StackPanel>
                </Button>
                <Button Grid.Column="6" x:Name="BibleBtn" Style="{StaticResource TextButton}"
                        Content="BIBLE" Click="BibleBtn_Click" ToolTip="Open the Bookmark Bible"/>
                <Button Grid.Column="7" x:Name="SnapBtn" Style="{StaticResource GlyphButton}"
                        Content="&#xE722;" Click="SnapBtn_Click" ToolTip="Snap this view into the Shot Vault (Ctrl+Shift+S, Shift-click = full page)">
                </Button>
                <Button Grid.Column="8" x:Name="DownloadsBtn" Style="{StaticResource GlyphButton}"
                        Content="&#xE896;" Click="DownloadsBtn_Click" ToolTip="Downloads (Ctrl+J)">
                    <Button.ContextMenu><ContextMenu/></Button.ContextMenu>
                </Button>
                <Button Grid.Column="9" x:Name="MenuBtn" Style="{StaticResource GlyphButton}"
                        Content="&#xE712;" Click="MenuBtn_Click" ToolTip="Menu">
                    <Button.ContextMenu>
                        <ContextMenu x:Name="MainMenu" Opened="MainMenu_Opened">
                            <MenuItem Header="New tab                 Ctrl+T" Click="MenuNewTab_Click"/>
                            <MenuItem Header="Reopen closed tab    Ctrl+Shift+T" Click="MenuReopen_Click"/>
                            <MenuItem Header="Duplicate tab" Click="MenuDuplicate_Click"/>
                            <Separator/>
                            <MenuItem Header="Find in page          Ctrl+F" Click="MenuFind_Click"/>
                            <MenuItem Header="Zoom in                  Ctrl++" Click="MenuZoomIn_Click"/>
                            <MenuItem Header="Zoom out                 Ctrl+-" Click="MenuZoomOut_Click"/>
                            <MenuItem Header="Reset zoom              Ctrl+0" Click="MenuZoomReset_Click"/>
                            <Separator/>
                            <MenuItem Header="Print…                  Ctrl+P" Click="MenuPrint_Click"/>
                            <MenuItem Header="Save page as PDF…" Click="MenuPdf_Click"/>
                            <MenuItem Header="Save page as…" Click="MenuSaveAs_Click"/>
                            <MenuItem Header="Screenshot (full page)" Click="MenuShot_Click"/>
                            <MenuItem Header="View page source        Ctrl+U" Click="MenuSource_Click"/>
                            <MenuItem Header="DevTools                     F12" Click="MenuDevTools_Click"/>
                            <Separator/>
                            <MenuItem Header="Downloads               Ctrl+J" Click="MenuDownloads_Click"/>
                            <MenuItem Header="History                 Ctrl+H" Click="MenuHistory_Click"/>
                            <MenuItem Header="Bookmark Bible" Click="MenuBible_Click"/>
                            <MenuItem Header="Credential vault" Click="MenuVault_Click"/>
                            <MenuItem Header="Archive" Click="MenuArchive_Click"/>
                            <MenuItem Header="Agent API" Click="MenuAgent_Click"/>
                            <MenuItem Header="Settings" Click="MenuSettings_Click"/>
                            <Separator/>
                            <MenuItem Header="About LYGO Browser" Click="MenuAbout_Click"/>
                        </ContextMenu>
                    </Button.ContextMenu>
                </Button>
            </Grid>

            <!-- ============ find bar ============ -->
            <Border Grid.Row="3" x:Name="FindBar" Visibility="Collapsed" Background="#080D12"
                    BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,1" Padding="10,5">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="FIND" Foreground="{StaticResource Gold}" FontSize="9.5"
                               FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"
                               Margin="0,0,10,0"/>
                    <TextBox x:Name="FindBox" Style="{StaticResource AddressBox}" Width="280" Height="28"
                             KeyDown="FindBox_KeyDown" TextChanged="FindBox_TextChanged"/>
                    <TextBlock x:Name="FindCount" Foreground="{StaticResource Muted}" FontSize="10.5"
                               FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"
                               Margin="10,0,6,0" Text="0 / 0"/>
                    <Button Style="{StaticResource GlyphButton}" Content="&#xE70E;" Click="FindPrev_Click"
                            ToolTip="Previous (Shift+Enter)"/>
                    <Button Style="{StaticResource GlyphButton}" Content="&#xE70D;" Click="FindNext_Click"
                            ToolTip="Next (Enter)"/>
                    <Button Style="{StaticResource GlyphButton}" Content="&#x2715;" Click="FindClose_Click"
                            ToolTip="Close (Esc)" FontFamily="Segoe UI" FontSize="10"/>
                </StackPanel>
            </Border>

            <!-- ============ bookmark bar ============ -->
            <Border Grid.Row="4" Background="#080D12" BorderBrush="{StaticResource Line}"
                    BorderThickness="0,1,0,1" AllowDrop="True"
                    DragOver="BookmarkBar_DragOver" Drop="BookmarkBar_Drop">
                <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="BookmarkBar" Orientation="Horizontal" Margin="8,0"
                                VerticalAlignment="Center"/>
                </ScrollViewer>
            </Border>

            <!-- ============ content ============ -->
            <Grid Grid.Row="5" x:Name="TabHost" Background="{StaticResource Obsidian}"/>

            <!-- ============ status ============ -->
            <Grid Grid.Row="6" Background="#070B10">
                <TextBlock x:Name="StatusText" Foreground="{StaticResource Muted}" FontSize="10"
                           FontFamily="{StaticResource MonoFont}" Margin="10,0,0,0"
                           VerticalAlignment="Center" Text="READY"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,0,10,0">
                    <TextBlock x:Name="DownloadText" Foreground="{StaticResource Cyan}" FontSize="10"
                               FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"
                               Margin="0,0,12,0"/>
                    <TextBlock x:Name="ZoomText" Foreground="#5A646C" FontSize="10"
                               FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"
                               Margin="0,0,12,0" Text="100%"/>
                    <TextBlock x:Name="StatusRight" Foreground="#5A646C" FontSize="10"
                               FontFamily="{StaticResource MonoFont}" VerticalAlignment="Center"/>
                </StackPanel>
            </Grid>
        </Grid>
    </Border>
</Window>
